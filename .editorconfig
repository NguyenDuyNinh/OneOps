root = true

# Mọi file: UTF-8, LF, có newline cuối file, không để khoảng trắng cuối dòng.
# Mục đích: không sinh diff chỉ vì editor của 17 người cấu hình khác nhau.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.prisma]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
