// ============================================================
// Module Bình Luận & Trao Đổi Công Việc (Task Comments)
// ============================================================

model TaskComment {
  id               String          @id @default(cuid())
  taskId           String          @map("task_id")
  authorId         String          @map("author_id")
  content          String
  type             CommentType     @default(COMMENT)
  mentions         String[]        @default([])
  links            String[]        @default([])
  attachments      Json?
  proposedDeadline DateTime?       @map("proposed_deadline")
  proposalStatus   ProposalStatus? @map("proposal_status")
  reviewedById     String?         @map("reviewed_by_id")
  rejectionReason  String?         @map("rejection_reason")
  isSystemLog      Boolean         @default(false) @map("is_system_log")
  createdAt        DateTime        @default(now()) @map("created_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@map("task_comments")
  @@index([taskId])
}

enum CommentType {
  COMMENT
  DEADLINE_PROPOSAL
}

