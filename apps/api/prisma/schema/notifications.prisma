model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  actionUrl String?          @map("action_url")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  ATTENDANCE_REMINDER
  ATTENDANCE_ABSENT_ALERT
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_DEADLINE_WARNING
  TASK_OVERDUE
  TASK_NEEDS_REASSIGNMENT
  PROPOSAL_CREATED
  PROPOSAL_REVIEWED
  CHAT_MENTIONED
  CHAT_NEW_MESSAGE
  LEAVE_REQUEST_CREATED
  LEAVE_REQUEST_REVIEWED
}
