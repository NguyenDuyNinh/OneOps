model Task {
  id                String             @id @default(cuid())
  title             String
  description       String?
  status            TaskStatus         @default(TODO)
  deadlineStatus    TaskDeadlineStatus @default(NORMAL) @map("deadline_status")
  deadline          DateTime
  assigneeId        String             @map("assignee_id")
  createdById       String             @map("created_by_id")
  needsReassignment Boolean            @default(false) @map("needs_reassignment")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  assignee   User           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy  User           @relation("TaskCreator", fields: [createdById], references: [id])
  logs       TaskLog[]
  proposals  TaskProposal[]
  comments   TaskComment[]

  @@map("tasks")
  @@index([assigneeId])
  @@index([status])
  @@index([deadline])
  @@index([deadlineStatus])
}

model TaskLog {
  id          String     @id @default(cuid())
  taskId      String     @map("task_id")
  fromStatus  TaskStatus @map("from_status")
  toStatus    TaskStatus @map("to_status")
  changedById String     @map("changed_by_id")
  reason      String?
  createdAt   DateTime   @default(now()) @map("created_at")

  task      Task @relation(fields: [taskId], references: [id])
  changedBy User @relation(fields: [changedById], references: [id])

  @@map("task_logs")
  @@index([taskId])
}

model TaskProposal {
  id               String         @id @default(cuid())
  taskId           String         @map("task_id")
  type             ProposalType
  status           ProposalStatus @default(PENDING)
  reason           String
  proposedDeadline DateTime?      @map("proposed_deadline")
  proposedById     String         @map("proposed_by_id")
  reviewedById     String?        @map("reviewed_by_id")
  rejectionReason  String?        @map("rejection_reason")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  task       Task @relation(fields: [taskId], references: [id])
  proposedBy User @relation(fields: [proposedById], references: [id])

  @@map("task_proposals")
  @@index([taskId])
  @@index([status])
}



enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  REWORK
  DONE
  PAUSED
  CANCELLED
}

enum TaskDeadlineStatus {
  NORMAL
  WARNING
  OVERDUE
}

enum ProposalType {
  PAUSE
  CANCEL
  CHANGE_DEADLINE
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}
