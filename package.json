{
  "name": "oneops",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @oneops/api --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter @oneops/api dev",
    "build": "pnpm --filter @oneops/api --filter web build",
    "lint": "pnpm lint:structure",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "db:migrate": "pnpm --filter @oneops/api db:migrate",
    "db:generate": "pnpm --filter @oneops/api db:generate",
    "db:seed": "pnpm --filter @oneops/api db:seed",
    "db:studio": "pnpm --filter @oneops/api db:studio",
    "db:reset": "pnpm --filter @oneops/api db:reset",
    "lint:structure": "node scripts/check-boundaries.mjs",
    "nav:gen": "pnpm --filter web nav:gen",
    "verify": "pnpm nav:gen && pnpm lint:structure && pnpm typecheck",
    "postinstall": "node scripts/gen-nav.mjs",
    "ui:drift": "node scripts/ui-drift.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
