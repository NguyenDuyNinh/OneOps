model Employee {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @db.VarChar(50)
  codeKey        String    @unique @db.VarChar(50)
  fullName       String    @db.VarChar(200)
  email          String    @default("") @db.VarChar(200)
  emailKey       String?   @unique @db.VarChar(200)
  phone          String    @default("") @db.VarChar(40)
  jobTitle       String    @default("") @db.VarChar(150)
  departmentName String    @default("") @db.VarChar(200)
  teamName       String    @default("") @db.VarChar(200)
  managerName    String    @default("") @db.VarChar(150)
  startDate      DateTime? @db.Date
  status         String    @default("ACTIVE") @db.VarChar(20)
  note           String    @default("") @db.VarChar(2000)
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, fullName])
  @@index([departmentName, status])
  @@index([jobTitle, status])
  @@map("employees")
  @@schema("hr_employees")
}
