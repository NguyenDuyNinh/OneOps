// ============================================================
// Prisma Schema — OneOps
// ============================================================
// CẢNH BÁO: Đây là file SHARED.
// Mỗi dev thêm các model thuộc module của mình vào đây.
// BẮT BUỘC thông báo team và tạo PR riêng cho mọi thay đổi schema.
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SHARED Models
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         UserRole @default(EMPLOYEE)
  avatarUrl    String?  @map("avatar_url")
  departmentId String?  @map("department_id")
  managerId    String?  @map("manager_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // [Dev 1] Attendance relations
  attendances      Attendance[]
  attendanceLogs   AttendanceLog[]

  // [Dev 2] Task relations
  assignedTasks    Task[]         @relation("TaskAssignee")
  createdTasks     Task[]         @relation("TaskCreator")
  taskLogs         TaskLog[]
  taskProposals    TaskProposal[]
  taskComments     TaskComment[]

  // [Dev 3] Chat & Notification relations
  chatMemberships  ChatMember[]
  sentMessages     Message[]
  notifications    Notification[]

  // Self-relation (manager hierarchy)
  manager          User?  @relation("UserManager", fields: [managerId], references: [id])
  subordinates     User[] @relation("UserManager")

  @@map("users")
  @@index([email])
  @@index([managerId])
}

enum UserRole {
  EMPLOYEE
  MANAGER
  ADMIN
}

// ============================================================
// [Dev 1] — Module Điểm Danh & Ca Làm Việc
// ============================================================

model Attendance {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  status        WorkStatus
  checkedInAt   DateTime       @map("checked_in_at")
  checkedOutAt  DateTime?      @map("checked_out_at")
  checkInLabel  CheckInLabel?  @map("check_in_label")
  checkOutLabel CheckOutLabel? @map("check_out_label")
  clientIp      String?        @map("client_ip")
  note          String?
  workLocation  String?        @map("work_location")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  logs AttendanceLog[]

  @@map("attendances")
  @@index([userId])
  @@index([checkedInAt])
  @@unique([userId, checkedInAt]) // Không cho check-in 2 lần cùng ngày
}

model AttendanceLog {
  id           String     @id @default(cuid())
  attendanceId String     @map("attendance_id")
  userId       String     @map("user_id")
  action       String     // "CHECK_IN", "CHECK_OUT", "STATUS_CHANGED", "AUTO_CLOSED"
  fromStatus   WorkStatus? @map("from_status")
  toStatus     WorkStatus  @map("to_status")
  note         String?
  createdAt    DateTime   @default(now()) @map("created_at")

  attendance Attendance @relation(fields: [attendanceId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@map("attendance_logs")
  @@index([attendanceId])
  @@index([userId])
}

model WorkConfig {
  id                 String   @id @default(cuid())
  lateThresholdTime  String   @default("07:55") @map("late_threshold_time")
  earlyCheckoutTime  String   @default("17:30") @map("early_checkout_time")
  autoCloseTime      String   @default("23:59") @map("auto_close_time")
  officeAllowedIps   String[] @map("office_allowed_ips")
  holidayDates       String[] @map("holiday_dates")  // ISO date strings
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("work_configs")
}

enum WorkStatus {
  AT_OFFICE
  REMOTE
  ON_DUTY
  ON_LEAVE
  SICK_LEAVE
  ABSENT
  NOT_CHECKED_IN
}

enum CheckInLabel {
  ON_TIME
  LATE
}

enum CheckOutLabel {
  NORMAL
  EARLY
  MISSING
}

// ============================================================
// [Dev 2] — Module Quản Lý Công Việc & Kanban Board
// ============================================================

model Task {
  id               String             @id @default(cuid())
  title            String
  description      String?
  status           TaskStatus         @default(TODO)
  deadlineStatus   TaskDeadlineStatus @default(NORMAL) @map("deadline_status")
  deadline         DateTime
  assigneeId       String             @map("assignee_id")
  createdById      String             @map("created_by_id")
  needsReassignment Boolean           @default(false) @map("needs_reassignment")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  assignee   User           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy  User           @relation("TaskCreator", fields: [createdById], references: [id])
  logs       TaskLog[]
  proposals  TaskProposal[]
  comments   TaskComment[]

  @@map("tasks")
  @@index([assigneeId])
  @@index([status])
  @@index([deadline])
  @@index([deadlineStatus])
}

model TaskLog {
  id          String     @id @default(cuid())
  taskId      String     @map("task_id")
  fromStatus  TaskStatus @map("from_status")
  toStatus    TaskStatus @map("to_status")
  changedById String     @map("changed_by_id")
  reason      String?
  createdAt   DateTime   @default(now()) @map("created_at")

  task      Task @relation(fields: [taskId], references: [id])
  changedBy User @relation(fields: [changedById], references: [id])

  @@map("task_logs")
  @@index([taskId])
}

model TaskProposal {
  id               String         @id @default(cuid())
  taskId           String         @map("task_id")
  type             ProposalType
  status           ProposalStatus @default(PENDING)
  reason           String
  proposedDeadline DateTime?      @map("proposed_deadline")
  proposedById     String         @map("proposed_by_id")
  reviewedById     String?        @map("reviewed_by_id")
  rejectionReason  String?        @map("rejection_reason")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  task       Task  @relation(fields: [taskId], references: [id])
  proposedBy User  @relation(fields: [proposedById], references: [id])

  @@map("task_proposals")
  @@index([taskId])
  @@index([status])
}

model TaskComment {
  id          String   @id @default(cuid())
  taskId      String   @map("task_id")
  authorId    String   @map("author_id")
  content     String
  isSystemLog Boolean  @default(false) @map("is_system_log")
  createdAt   DateTime @default(now()) @map("created_at")

  task   Task @relation(fields: [taskId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@map("task_comments")
  @@index([taskId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  REWORK
  DONE
  PAUSED
  CANCELLED
}

enum TaskDeadlineStatus {
  NORMAL
  WARNING
  OVERDUE
}

enum ProposalType {
  PAUSE
  CANCEL
  CHANGE_DEADLINE
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// [Dev 3] — Module Chat & Thông Báo
// ============================================================

model ChatRoom {
  id        String       @id @default(cuid())
  name      String?
  type      ChatRoomType
  createdAt DateTime     @default(now()) @map("created_at")

  members  ChatMember[]
  messages Message[]

  @@map("chat_rooms")
}

model ChatMember {
  id       String   @id @default(cuid())
  roomId   String   @map("room_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  room ChatRoom @relation(fields: [roomId], references: [id])
  user User     @relation(fields: [userId], references: [id])

  @@map("chat_members")
  @@unique([roomId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String   @map("room_id")
  senderId  String   @map("sender_id")
  content   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  room   ChatRoom @relation(fields: [roomId], references: [id])
  sender User     @relation(fields: [senderId], references: [id])

  @@map("messages")
  @@index([roomId])
  @@index([senderId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  actionUrl String?          @map("action_url")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum ChatRoomType {
  DIRECT
  GROUP
}

enum NotificationType {
  ATTENDANCE_REMINDER
  ATTENDANCE_ABSENT_ALERT
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_DEADLINE_WARNING
  TASK_OVERDUE
  TASK_NEEDS_REASSIGNMENT
  PROPOSAL_CREATED
  PROPOSAL_REVIEWED
  CHAT_MENTIONED
  CHAT_NEW_MESSAGE
  LEAVE_REQUEST_CREATED
  LEAVE_REQUEST_REVIEWED
}
